# Secrets never enter the image (injected at runtime via --env-file .env)
.env

# Git and IDE
.git/
.gitignore
.vscode/
.idea/

# Runtime artifacts (regenerated automatically inside the container)
workspace/
output/
chroma_db/

# Python cache
__pycache__/
*.pyc
.venv/

# Doc screenshots (not needed at runtime)
docs/

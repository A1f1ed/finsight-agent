# ===== Alibaba Cloud Bailian (DashScope) =====
# API key: obtain from the Alibaba Cloud Bailian console
DASHSCOPE_API_KEY=your-dashscope-api-key-here
# OpenAI-compatible endpoint
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Model config (optional, defaults provided) =====
CHAT_MODEL=qwen3.7-plus
EMBEDDING_MODEL=qwen3.7-text-embedding
# Separate endpoint for embeddings (optional): falls back to DASHSCOPE_BASE_URL.
# If you use a Bailian dedicated-workspace endpoint, set it here:
# EMBEDDING_BASE_URL=https://<your-workspace>.maas.aliyuncs.com/compatible-mode/v1

# ===== LangSmith observability (optional) =====
# Sign up at https://smith.langchain.com to inspect traces of every step
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=finsight-agent

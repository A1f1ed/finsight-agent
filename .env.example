# ===== 阿里云百炼（DashScope）配置 =====
# API Key: 阿里云百炼控制台获取
DASHSCOPE_API_KEY=your-dashscope-api-key-here
# OpenAI 兼容模式端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 模型配置（可选，有默认值）=====
CHAT_MODEL=qwen3.7-plus
EMBEDDING_MODEL=qwen3.7-text-embedding
# embedding 单独端点（可选）：默认复用 DASHSCOPE_BASE_URL。
# 如果使用百炼专属工作空间端点，填在这里：
# EMBEDDING_BASE_URL=https://<your-workspace>.maas.aliyuncs.com/compatible-mode/v1

# ===== LangSmith 可观测性（可选）=====
# 注册 https://smith.langchain.com 后可查看每一步的 trace
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=finsight-agent
